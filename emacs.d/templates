fundamental-mode ;; Available everywhere

(today (format-time-string "%Y-%m-%d"))

org-mode
(diary "#+TITLE: " (format-time-string "%Y-%m-%d") "の日報" n
       "#+DESCRIPTION: " (format-time-string "%-m/%-d") "の日報をお届けいたします。" n
       "#+DATE: [" (format-time-string "%Y-%m-%d %a") "]" n
       "#+EMOJI: 🦊" n
       "#+DRAFT: false" n n
       "** 今日やったこと" n n n
       "** 明日以降やりたいこと" n)

(article "#+TITLE: " n
       "#+DESCRIPTION: " n
       "#+DATE: [" (format-time-string "%Y-%m-%d %a") "]" n
       "#+FILETAGS: :" n
       "#+EMOJI: 🦊" n
       "#+DRAFT: true" n n)

emacs-lisp-mode


git-commit-mode
(future (":sparkles: " "( " p " )" " " p ))
